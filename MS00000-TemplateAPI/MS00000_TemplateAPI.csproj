<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	<WarningsAsErrors>$(WarningsAsErrors);RS0030</WarningsAsErrors>
    <RootNamespace>MS00000_TemplateAPI</RootNamespace>
	<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
	<DockerfileContext>.</DockerfileContext>
	<DockerfileRunArguments>-p 32907:8080</DockerfileRunArguments>
	<GenerateDocumentationFile>True</GenerateDocumentationFile>	  
	<LocalPackagesPath>$(MSBuildProjectDirectory)\local-packages</LocalPackagesPath>
	<RestoreAdditionalProjectSources Condition="Exists('$(LocalPackagesPath)')">
		$(LocalPackagesPath)
	</RestoreAdditionalProjectSources>  
	  
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="8.1.0" />
	<PackageReference Include="Flowify" Version="0.5.3" />
	<PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0">
	  <PrivateAssets>all</PrivateAssets>
	  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	</PackageReference>
	<PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
	<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
	<PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
	<PackageReference Include="INPS.ServiceDefault.Core" Version="1.3.0" />
  </ItemGroup>

  <ItemGroup>
	<AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>
	<Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(Configuration)' == 'Debug'">
		<Exec Command="dotnet tool restore"></Exec>
		<Exec Command="dotnet swagger tofile --output openapi.yaml --yaml $(OutputPath)$(AssemblyName).dll v1" EnvironmentVariables="SERVICEDEFAULTS_OPENAPI_GENERATION=true" />
	</Target>

</Project>
