<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MS00000_TemplateAPI</RootNamespace>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
	  <DockerfileContext>.</DockerfileContext>
	  <DockerfileRunArguments>-p 32907:8080 </DockerfileRunArguments>
	  <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="8.1.0" />
	<PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
	  <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

	<ItemGroup>
		<!-- Reference per compilazione -->
		<Reference Include="INPS.ServiceDefault">
			<HintPath>libs/ServiceDefaults/INPS.ServiceDefault.dll</HintPath>
		</Reference>
	</ItemGroup>
	<ItemGroup>
		<!-- Copia fisica in output (FONDAMENTALE in pipeline) -->
		<None Include="libs/ServiceDefaults/INPS.ServiceDefault.dll">
		    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
